{
  "name": "local-ai-backend",
  "version": "1.0.0",
  "description": "AI summary backend for the Local app — generates & serves video summaries.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe:gem": "ts-node --transpile-only scripts/gem_probe.ts",
    "probe:summary": "ts-node --transpile-only scripts/summary_probe.ts",
    "probe:place": "ts-node --transpile-only scripts/place_resolve_probe.ts",
    "test:place": "ts-node --transpile-only scripts/place_pipeline_test.ts",
    "check:proofread": "ts-node --transpile-only scripts/proofread_check.ts",
    "check:hashtag": "ts-node --transpile-only scripts/hashtag_check.ts",
    "check:place-scope": "ts-node --transpile-only scripts/place_scope_check.ts",
    "check:place-multi": "ts-node --transpile-only scripts/place_multi_query_check.ts",
    "check:place-e2e": "ts-node --transpile-only scripts/place_e2e_check.ts",
    "check:routes": "ts-node --transpile-only scripts/routes_probe.ts",
    "check:folder": "ts-node --transpile-only scripts/folder_context_check.ts",
    "test:folder": "ts-node --transpile-only scripts/folder_context_test.ts",
    "test:vca2": "ts-node --transpile-only scripts/vca_v2_test.ts",
    "check:vca2": "ts-node --transpile-only scripts/vca_v2_osm_check.ts",
    "check:vca2:places": "ts-node --transpile-only scripts/vca_v2_places_check.ts",
    "check:vca2:proofread": "ts-node --transpile-only scripts/vca_v2_card_proofread_check.ts",
    "probe:vca2": "ts-node --transpile-only scripts/vca_v2_probe.ts",
    "preview:vca2": "ts-node --transpile-only scripts/vca_v2_preview.ts",
    "fix:hashtags": "ts-node --transpile-only scripts/fix_hashtags.ts",
    "lint": "expo lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.2",
    "@vercel/node": "^3.2.29",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
