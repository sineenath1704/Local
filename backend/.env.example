# ---- Server ----
PORT=1025

# ---- AI provider (Anthropic-compatible endpoint) ----
# These stay on the SERVER only. Never ship them inside the mobile app bundle.
ANTHROPIC_BASE_URL=https://your-ai-endpoint.example.com/api
ANTHROPIC_AUTH_TOKEN=your-ai-token-here
ANTHROPIC_MODEL=minimax-m3

# Request timeout to the AI endpoint (ms)
AI_TIMEOUT_MS=120000

# Max tokens for the summary response
AI_MAX_TOKENS=1024

# ---- Supabase (service_role — SERVER ONLY, bypasses RLS) ----
# Persists AI summaries into the `videos` table at upload time.
# Get the service_role key from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
