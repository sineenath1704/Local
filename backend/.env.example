# ---- Server ----
PORT=1025

# ---- AI provider (Anthropic-compatible endpoint) ----
# These stay on the SERVER only. Never ship them inside the mobile app bundle.
ANTHROPIC_BASE_URL=https://your-ai-endpoint.example.com/api
ANTHROPIC_AUTH_TOKEN=your-ai-token-here
ANTHROPIC_MODEL=minimax-m3

# Request timeout to the AI endpoint (ms)
AI_TIMEOUT_MS=120000

# Max tokens for the summary response
AI_MAX_TOKENS=32768

# ---- Proofread pass (แก้การสะกดไทยในสรุป + คำบรรยาย) ----
# เปิดไว้โดย default — ปิดได้ด้วย off ถ้าไม่อยากเสียเวลาเรียกโมเดลเพิ่ม
PROOFREAD_ENABLED=on

# โมเดลสำหรับรอบแก้สะกด — เว้นว่างไว้ = ใช้ ANTHROPIC_MODEL เหมือนกัน
AI_PROOFREAD_MODEL=

# ---- Google APIs (SERVER ONLY — ใช้คนละคีย์กัน) ----
# Places: ค้นหาสถานที่ + ดึงข้อมูลร้าน/จุดตรวจเช็ค (เฉพาะ Places เท่านั้น)
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# Speech-to-Text: ถอดเสียงพูดจากไฟล์วิดีโอ (เฉพาะ Speech-to-Text เท่านั้น)
# ใช้คนละคีย์กับ Places เพราะ API restrictions ของแต่ละคีย์ไม่ให้ใช้ข้ามกัน
GOOGLE_STT_API_KEY=your-google-stt-key-here

# ---- Google AI / Gemini (SERVER ONLY) — ถอดเสียงจากวิดีโอ (ทางเลือกแทน STT) ----
# Gemini รับทั้งไฟล์เสียงและไฟล์วิดีโอ (video/mp4) แล้วถอดเสียงได้ตรง ๆ
# ไฟล์เล็ก (≤15MB) ส่ง URL ให้ Gemini ดึงเองได้ / ไฟล์ใหญ่ต้องใช้ Files API
# หมดเวลาในการถอดเสียง (ms)
GEMINI_TIMEOUT_MS=120000
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# ---- Supabase (service_role — SERVER ONLY, bypasses RLS) ----
# Persists AI summaries into the `videos` table at upload time.
# Get the service_role key from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
